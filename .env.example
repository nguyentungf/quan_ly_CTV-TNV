# Cổng chạy ứng dụng (Mặc định: 5000)
PORT=5000

# Môi trường chạy ('production' hoặc 'development')
NODE_ENV=production

# KẾT NỐI DATABASE:
# 1. Để trống DATABASE_URL nếu muốn chạy SQLite cục bộ lưu trong file 'server/data/database.sqlite'
# 2. Hoặc điền chuỗi kết nối PostgreSQL (Render, Neon.tech, Supabase, Railway) để lưu trữ vĩnh viễn trên đám mây:
# DATABASE_URL=postgresql://user:password@host:port/database_name?sslmode=require

